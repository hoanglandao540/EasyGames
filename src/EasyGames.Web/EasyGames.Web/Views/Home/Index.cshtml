@{
    ViewData["Title"] = "Home";
}

@section Head {
     <style >
           .eg-hero {
                background: radial-gradient(1200px 400px at -10% -20%, rgba(212,175,55,.12), transparent 60%), radial-gradient(900px 360px at 110% -10%, rgba(241,196,15,.10), transparent 60%), linear-gradient(180deg, var(--eg-surface), var(--eg-surface-2));
                border: 1px solid var(--eg-border);
                border-radius: 22px;
                box-shadow: 0 20px 60px -30px rgba(0,0,0,.7);
                    }

           .eg-hero h1 {
                color: var(--eg-gold);
                letter-spacing: .5px;
                        }

           .eg-hero p.lead {
                color: var(--eg-muted);
                         }

           .eg-quick a.card {
                transition: transform .15s ease;
                      }

           .eg-quick a.card:hover {
                transform: translateY(-2px);
                border-color: var(--eg-gold);
                               }

           .eg-quick .card .card-text.text-muted {
                color: #cbd5e1 !important;
               }


        .eg-quick .card .card-title {
            color: var(--eg-gold);
        }
    </style>
}

<div class="eg-hero p-4 p-md-5 mb-4">
    <h1 class="display-6 fw-bold">EasyGames</h1>
    <p class="lead mt-2">
        @* Small human comment: this text is intentionally simple and friendly *@
        Welcome — manage products, browse the catalog, or use the shop POS.
    </p>

    <div class="mt-3 d-flex flex-wrap gap-2">
        @* Buttons are gold so important actions pop *@
        <a class="btn btn-eg" asp-area="Owner" asp-controller="Products" asp-action="Index">Go to Products</a>
        <a class="btn btn-eg" asp-area="Storefront" asp-controller="Catalog" asp-action="Index">Open Catalog</a>
        <a class="btn btn-eg" asp-area="Shop" asp-controller="Pos" asp-action="Index">Launch POS</a>
    </div>
</div>

<div class="eg-quick row g-3">
    <div class="col-12 col-md-4">
        <a class="card text-decoration-none" asp-area="Owner" asp-controller="Products" asp-action="Index">
            <div class="card-body">
                <h5 class="card-title mb-1">Owner → Products</h5>
                <p class="card-text text-muted small">
                    Create, edit, and list products. 
                </p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a class="card text-decoration-none" asp-area="Storefront" asp-controller="Catalog" asp-action="Index">
            <div class="card-body">
                <h5 class="card-title mb-1">Storefront → Catalog</h5>
                <p class="card-text text-muted small">
                    Browse items and add to cart.
                </p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a class="card text-decoration-none" asp-area="Shop" asp-controller="Pos" asp-action="Index">
            <div class="card-body">
                <h5 class="card-title mb-1">Shop → POS</h5>
                <p class="card-text text-muted small">
                    Fast checkout inside the shop. 
                </p>
            </div>
        </a>
    </div>
</div>