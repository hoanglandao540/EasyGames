@model EasyGames.Web.ViewModels.ShopStocksVM
@{
    ViewData["Title"] = "Shop Stocks";
}

@section Head {
    <style>
        /* Midnight + Gold — per-page token pack */
        :root {
            --eg-bg: #0b0f19;
            --eg-surface: #0f172a;
            --eg-surface-2: #0b1222;
            --eg-gold: #d4af37;
            --eg-gold-2: #f1c40f;
            --eg-text: #cbd5e1;
            --eg-border: #1e293b;
            --eg-shadow: 0 6px 24px rgba(0,0,0,.35);
        }

        body {
            background: var(--eg-bg);
            color: var(--eg-text);
        }

        .eg-container {
            max-width: 1100px;
            margin: 24px auto;
            padding: 0 12px;
        }

        .eg-card {
            background: var(--eg-surface);
            border-radius: 14px;
            padding: 18px;
            box-shadow: var(--eg-shadow);
        }

        .eg-h1 {
            color: var(--eg-gold);
            margin: 0 0 10px;
            font-weight: 700;
        }

        .eg-btn {
            background: var(--eg-gold);
            color: #111;
            border: none;
            border-radius: 10px;
            padding: 8px 14px;
            font-weight: 600;
        }

            .eg-btn:hover {
                background: var(--eg-gold-2);
            }

        .eg-btn-sm {
            padding: 6px 10px;
            border-radius: 8px;
        }

        .eg-table {
            width: 100%;
            border-collapse: collapse;
        }

            .eg-table th, .eg-table td {
                padding: 10px;
                border-bottom: 1px solid var(--eg-border);
            }

            .eg-table th {
                color: var(--eg-gold);
                font-weight: 600;
            }

        .eg-toolbar {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 12px;
        }

            .eg-toolbar a {
                color: var(--eg-text);
                text-decoration: none;
            }

        @@media (max-width:640px) {
            .eg-container {
                padding: 0 8px;
            }
        }
    </style>
}

<div class="eg-container">
    <h2 class="eg-h1">Stocks — @Model.ShopName</h2>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div style="margin:12px 0; padding:10px 14px; background:#123; border-left:4px solid var(--eg-gold); border-radius:10px;">
            @Model.Message
        </div>
    }

    <div class="eg-card">
        <div class="eg-toolbar">
            <a asp-area="Owner" asp-controller="Shops" asp-action="Index" class="eg-btn eg-btn-sm">← Back to Shops</a>
        </div>

        <div class="table-responsive">
            <table class="eg-table">
                <thead>
                    <tr>
                        <th>Product Id</th>
                        <th>Name</th>
                        <th class="text-end">Qty</th>
                        <th class="text-end">Reorder</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td>@r.ProductId</td>
                            <td>@r.ProductName</td>
                            <td class="text-end">@r.Qty</td>
                            <td class="text-end">@r.ReorderLevel</td>
                            <td class="text-end">
                                <form asp-area="Owner" asp-controller="ShopStocks" asp-action="Dec" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="shopId" value="@Model.ShopId" />
                                    <input type="hidden" name="productId" value="@r.ProductId" />
                                    <button class="eg-btn eg-btn-sm" type="submit">–</button>
                                </form>
                                <form asp-area="Owner" asp-controller="ShopStocks" asp-action="Inc" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="shopId" value="@Model.ShopId" />
                                    <input type="hidden" name="productId" value="@r.ProductId" />
                                    <button class="eg-btn eg-btn-sm" type="submit">+</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


