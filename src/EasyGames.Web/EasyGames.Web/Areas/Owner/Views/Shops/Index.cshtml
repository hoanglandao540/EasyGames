@model IEnumerable<EasyGames.Web.ViewModels.ShopVM>
@{
    ViewData["Title"] = "Shops";
}

@section Head {
    <style>
        /* Midnight + Gold — per-page token pack */
        :root {
            --eg-bg: #0b0f19;
            --eg-surface: #0f172a;
            --eg-surface-2: #0b1222;
            --eg-gold: #d4af37;
            --eg-gold-2: #f1c40f;
            --eg-text: #cbd5e1;
            --eg-muted: #94a3b8;
            --eg-border: #1e293b;
            --eg-shadow: 0 6px 24px rgba(0,0,0,.35);
        }

        body {
            background: var(--eg-bg);
            color: var(--eg-text);
        }

        .eg-container {
            max-width: 1100px;
            margin: 24px auto;
            padding: 0 12px;
        }

        .eg-card {
            background: var(--eg-surface);
            border-radius: 14px;
            padding: 18px;
            box-shadow: var(--eg-shadow);
        }

        .eg-h1 {
            color: var(--eg-gold);
            margin: 0 0 10px;
            font-weight: 700;
        }

        .eg-btn {
            background: var(--eg-gold);
            color: #111;
            border: none;
            border-radius: 10px;
            padding: 8px 14px;
            font-weight: 600;
        }

            .eg-btn:hover {
                background: var(--eg-gold-2);
            }

        .eg-btn-sm {
            padding: 6px 10px;
            border-radius: 8px;
        }

        .eg-table {
            width: 100%;
            border-collapse: collapse;
        }

            .eg-table th, .eg-table td {
                padding: 10px;
                border-bottom: 1px solid var(--eg-border);
            }

            .eg-table th {
                color: var(--eg-gold);
                font-weight: 600;
            }
        /* Toolbar + equal control heights = consistent alignment */
        .eg-toolbar {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 12px;
        }

        .eg-toolbar-right {
            justify-content: flex-end;
        }

        .eg-btn, .eg-input {
            height: 40px;
        }

        @@media (max-width:640px) {
            .eg-container {
                padding: 0 8px;
            }
        }
    </style>
}

<div class="eg-container">
    <h2 class="eg-h1">Shops</h2>

    <div class="eg-card">
        <div class="eg-toolbar eg-toolbar-right">
            <a class="eg-btn eg-btn-sm" asp-area="Owner" asp-controller="Shops" asp-action="Create">Add Shop</a>
        </div>

        <div class="table-responsive">
            <table class="eg-table">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>City</th>
                        <th>Country</th>
                        <th>Phone</th>
                        <th class="text-end">SKUs</th>
                        <th class="text-end">Total Qty</th>
                        <th class="text-end">Low Stock</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.ShopCode</td>
                            <td>@s.ShopName</td>
                            <td>@s.City</td>
                            <td>@s.Country</td>
                            <td>@s.Phone</td>
                            <td class="text-end">@s.TotalSkus</td>
                            <td class="text-end">@s.TotalQty</td>
                            <td class="text-end">@s.LowStockSkus</td>
                            <td class="text-end">
                                <a class="eg-btn eg-btn-sm"
                                   asp-area="Owner" asp-controller="ShopStocks" asp-action="Index"
                                   asp-route-shopId="@s.Id">View Stock</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>



