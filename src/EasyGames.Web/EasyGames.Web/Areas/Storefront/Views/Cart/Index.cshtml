@model EasyGames.Web.ViewModels.CartVM
@{
    ViewData["Title"] = "Cart";
}

@section Head {
    <style>
        /* Midnight + Gold (page token pack) */
        :root{--eg-bg:#0b0f19;--eg-surface:#0f172a;--eg-gold:#d4af37;--eg-gold2:#f1c40f;--eg-text:#cbd5e1;--eg-border:#1e293b;--eg-shadow:0 6px 24px rgba(0,0,0,.35);}
        body{background:var(--eg-bg);color:var(--eg-text);}
        .eg-container{max-width:1100px;margin:24px auto;padding:0 12px;}
        .eg-card{background:var(--eg-surface);border-radius:14px;padding:18px;box-shadow:var(--eg-shadow);}
        .eg-h1{color:var(--eg-gold);margin:0 0 10px;font-weight:700;}
        .eg-btn{background:var(--eg-gold);color:#111;border:none;border-radius:10px;padding:8px 14px;font-weight:600;}
        .eg-btn:hover{background:var(--eg-gold2);}
        .eg-btn-sm{padding:6px 10px;border-radius:8px;}
        .eg-table{width:100%;border-collapse:collapse;}
        .eg-table th,.eg-table td{padding:10px;border-bottom:1px solid var(--eg-border);}
        .eg-table th{color:var(--eg-gold);font-weight:600;}
        .eg-right{display:flex;justify-content:flex-end;gap:10px;margin-top:14px;}
        .eg-note{background:#0b1222;border-left:4px solid var(--eg-gold);padding:12px;border-radius:10px;color:var(--eg-text);}
        a.eg-link{color:var(--eg-gold);text-decoration:underline;}
    </style>
}

<div class="eg-container">
    <div class="eg-card">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
            <h2 class="eg-h1" style="margin:0;">Your Cart</h2>
            <div style="color:var(--eg-gold);font-weight:700;">
                Items: @(Model?.Items?.Count ?? 0)
            </div>
        </div>

        @if (Model == null || Model.Items == null || Model.Items.Count == 0)
        {
            <div class="eg-note">
                Your cart is empty. <a class="eg-link" asp-area="Storefront" asp-controller="Catalog" asp-action="Index">Go to Catalog</a>.
            </div>
        }
        else
        {
            <table class="eg-table">
                <thead>
                    <tr>
                        <th style="width:90px;">ID</th>
                        <th>Name</th>
                        <th class="text-end" style="width:120px;">Price</th>
                        <th class="text-end" style="width:80px;">Qty</th>
                        <th class="text-end" style="width:140px;">Line Total</th>
                        <th class="text-end" style="width:160px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Items)
                    {
                        <tr>
                            <td>#@line.Id</td>
                            <td>@line.Name</td>
                            <td class="text-end">@line.Price.ToString("0.00")</td>
                            <td class="text-end">@line.Qty</td>
                            <td class="text-end">@((line.Price * line.Qty).ToString("0.00"))</td>
                            <td class="text-end">
                                <form asp-area="Storefront" asp-controller="Cart" asp-action="Inc" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@line.Id" />
                                    <button class="eg-btn eg-btn-sm" type="submit">+1</button>
                                </form>
                                <form asp-area="Storefront" asp-controller="Cart" asp-action="Remove" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@line.Id" />
                                    <button class="eg-btn eg-btn-sm" type="submit">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div style="margin-top:10px;font-weight:700;">
                Grand Total: <span style="color:var(--eg-gold)">@Model.GrandTotal.ToString("0.00")</span>
            </div>

            <div class="eg-right">
                <form asp-area="Storefront" asp-controller="Cart" asp-action="Clear" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button class="eg-btn eg-btn-sm" type="submit">Clear Cart</button>
                </form>
                <a class="eg-btn eg-btn-sm" asp-area="Storefront" asp-controller="Checkout" asp-action="Index">Checkout</a>
            </div>
        }
    </div>
</div>


