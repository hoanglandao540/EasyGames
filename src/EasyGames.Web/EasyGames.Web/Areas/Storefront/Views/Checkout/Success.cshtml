@{
    ViewData["Title"] = "Order Placed";
}

@section Head {
    <style>
        :root {
            --eg-bg: #0b0f19;
            --eg-surface: #0f172a;
            --eg-text: #e5e7eb;
            --eg-gold: #d4af37;
            --eg-border: rgba(212,175,55,.18);
        }

        .eg-card {
            background: linear-gradient(180deg,var(--eg-surface),#0b1220);
            border: 1px solid var(--eg-border);
            border-radius: 16px;
            padding: 28px;
            color: var(--eg-text);
            box-shadow: 0 10px 28px -14px rgba(0,0,0,.6);
            text-align: center;
        }

        .eg-title {
            color: var(--eg-gold);
        }

        .btn-eg {
            background: var(--eg-gold);
            color: #111;
            font-weight: 700;
            border: none;
        }

            .btn-eg:hover {
                background: #f1c40f;
                color: #111;
            }
    </style>
}
<div class="eg-card">
    <h2 class="eg-title mb-3">Thank you! 🎉</h2>
    <p>Your order was submitted successfully. We’ll email your confirmation shortly.</p>
    <a class="btn btn-eg mt-2" asp-area="Storefront" asp-controller="Catalog" asp-action="Index">Back to Catalog</a>
</div>



