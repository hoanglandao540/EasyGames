@model EasyGames.Web.ViewModels.CheckoutVM
@{
    ViewData["Title"] = "Checkout";
}

@section Head {
    <style>
        :root {
            --eg-bg: #0b0f19;
            --eg-surface: #0f172a;
            --eg-text: #e5e7eb;
            --eg-gold: #d4af37;
            --eg-border: rgba(212,175,55,.18);
        }

        .eg-card {
            background: linear-gradient(180deg,var(--eg-surface),#0b1220);
            border: 1px solid var(--eg-border);
            border-radius: 16px;
            padding: 18px;
            color: var(--eg-text);
            box-shadow: 0 10px 28px -14px rgba(0,0,0,.6);
        }

        .eg-title {
            color: var(--eg-gold);
        }

        .eg-table th {
            color: var(--eg-gold);
            border-bottom-color: var(--eg-border) !important;
        }

        .eg-table td {
            color: var(--eg-text);
            border-color: #182036 !important;
        }

        .btn-eg {
            background: var(--eg-gold);
            color: #111;
            font-weight: 700;
            border: none;
        }

            .btn-eg:hover {
                background: #f1c40f;
                color: #111;
            }

        .form-label {
            color: #cbd5e1;
        }

        .text-muted {
            color: #cbd5e1 !important;
        }
    </style>
}

@if (TempData["Msg"] is string m)
{
    <div class="alert alert-dark border" role="alert" style="border-color:var(--eg-border)">@m</div>
}

<div class="row g-3">
    <div class="col-12 col-lg-6">
        <div class="eg-card">
            <h2 class="eg-title mb-3">Your Details</h2>

            @*  validation summary shows all errors in one place *@
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <form asp-area="Storefront" asp-controller="Checkout" asp-action="Index" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label" asp-for="CustomerName">Full name</label>
                    <input class="form-control" asp-for="CustomerName" />
                    <span class="text-danger" asp-validation-for="CustomerName"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Email">Email</label>
                    <input class="form-control" asp-for="Email" />
                    <span class="text-danger" asp-validation-for="Email"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Phone">Phone</label>
                    <input class="form-control" asp-for="Phone" />
                    <span class="text-danger" asp-validation-for="Phone"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Address">Address</label>
                    <textarea class="form-control" rows="3" asp-for="Address"></textarea>
                    <span class="text-danger" asp-validation-for="Address"></span>
                </div>

                <button class="btn btn-eg w-100" type="submit">Place Order</button>
            </form>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="eg-card">
            <h2 class="eg-title mb-3">Order Summary</h2>
            @if (!Model.Lines.Any())
            {
                <div class="alert alert-dark border" style="border-color:var(--eg-border)">
                    No items. <a asp-area="Storefront" asp-controller="Catalog" asp-action="Index">Browse catalog</a>.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm eg-table align-middle">
                        <thead>
                            <tr>
                                <th style="width:80px">ID</th>
                                <th>Name</th>
                                <th class="text-end" style="width:120px">Price</th>
                                <th class="text-end" style="width:120px">Qty</th>
                                <th class="text-end" style="width:140px">Line Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Lines)
                            {
                                <tr>
                                    <td>#@r.ProductId</td>
                                    <td>@r.Name</td>
                                    <td class="text-end">৳ @r.Price</td>
                                    <td class="text-end">@r.Qty</td>
                                    <td class="text-end">৳ @r.LineTotal</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-between">
                    <div>Items: <strong>@Model.TotalItems</strong></div>
                    <div>Grand Total: <strong>৳ @Model.GrandTotal</strong></div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}



